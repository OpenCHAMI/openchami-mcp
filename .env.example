OPENCHAMI_MCP_MODE=read-only
OPENCHAMI_MCP_TRANSPORT=stdio
OPENCHAMI_MCP_ENABLE_WRITES=false
OPENCHAMI_MCP_REQUIRE_WRITE_ACK=true
OPENCHAMI_MCP_FRAMING=auto
OPENCHAMI_MCP_LOG_LEVEL=info
OPENCHAMI_MCP_LISTEN_ADDR=127.0.0.1:8081
OPENCHAMI_MCP_BASE_PATH=/mcp
OPENCHAMI_MCP_HEALTH_PATH=/healthz
OPENCHAMI_MCP_ALLOWED_ORIGINS=
OPENCHAMI_MCP_HTTP_BEARER_TOKEN=

OPENCHAMI_MCP_SMD_URL=https://localhost:27779
OPENCHAMI_MCP_SMD_TIMEOUT=10s
OPENCHAMI_MCP_SMD_RETRIES=1
OPENCHAMI_MCP_SMD_TLS_CA_FILE=
OPENCHAMI_MCP_SMD_TLS_INSECURE_SKIP_VERIFY=true

OPENCHAMI_MCP_BSS_URL=http://localhost:27778
OPENCHAMI_MCP_BSS_TIMEOUT=10s
OPENCHAMI_MCP_BSS_RETRIES=1
OPENCHAMI_MCP_BSS_TLS_CA_FILE=
OPENCHAMI_MCP_BSS_TLS_INSECURE_SKIP_VERIFY=false

OPENCHAMI_MCP_CLOUD_INIT_URL=http://localhost:27777
OPENCHAMI_MCP_CLOUD_INIT_TIMEOUT=10s
OPENCHAMI_MCP_CLOUD_INIT_RETRIES=1
OPENCHAMI_MCP_CLOUD_INIT_TLS_CA_FILE=
OPENCHAMI_MCP_CLOUD_INIT_TLS_INSECURE_SKIP_VERIFY=false

OPENCHAMI_MCP_POWER_CONTROL_URL=http://localhost:28007/v1
OPENCHAMI_MCP_POWER_CONTROL_TIMEOUT=10s
OPENCHAMI_MCP_POWER_CONTROL_RETRIES=1
OPENCHAMI_MCP_POWER_CONTROL_TLS_CA_FILE=
OPENCHAMI_MCP_POWER_CONTROL_TLS_INSECURE_SKIP_VERIFY=false

OPENCHAMI_MCP_KEA_URL=http://localhost:8000
OPENCHAMI_MCP_KEA_TIMEOUT=10s
OPENCHAMI_MCP_KEA_RETRIES=1
OPENCHAMI_MCP_KEA_DEFAULT_SERVICES=dhcp4
OPENCHAMI_MCP_KEA_TLS_CA_FILE=
OPENCHAMI_MCP_KEA_TLS_INSECURE_SKIP_VERIFY=false

# CoreDHCP currently has no standard upstream admin API. This URL is kept so a
# deployment-specific control surface can be wired later without changing the
# rest of the server configuration model.
OPENCHAMI_MCP_COREDHCP_URL=
OPENCHAMI_MCP_COREDHCP_TIMEOUT=10s
OPENCHAMI_MCP_COREDHCP_RETRIES=1
OPENCHAMI_MCP_COREDHCP_TLS_CA_FILE=
OPENCHAMI_MCP_COREDHCP_TLS_INSECURE_SKIP_VERIFY=false
